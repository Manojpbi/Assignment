	column issue_year = LOOKUPVALUE(dim_date[year], dim_date[date_key], fact_persistency[issue_date_key])
		dataType: int64
		formatString: 0
		lineageTag: 4b6c8f35-7da7-4d64-b5ab-2fa0a4ce5d2a
		summarizeBy: none

	column renewal_year = LOOKUPVALUE(dim_date[year], dim_date[date_key], fact_persistency[renewal_due_date_key])
		dataType: int64
		formatString: 0
		lineageTag: 5c7d9f46-8eb8-4e75-c6bc-3fb1b5df6e3b
		summarizeBy: none

