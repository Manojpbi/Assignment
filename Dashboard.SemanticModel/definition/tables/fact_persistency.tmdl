table fact_persistency
	excludeFromModelRefresh
	lineageTag: b2d335e0-e47c-422e-8194-f7aae325334a

	measure 'Persistency Rate' =
			VAR RenewedPolicies =
				CALCULATE(
					COUNTROWS(fact_persistency),
					CROSSFILTER(fact_persistency[issue_date_key], dim_date[date_key], NONE),
					USERELATIONSHIP(fact_persistency[renewal_due_date_key], dim_date[date_key])
				)
			VAR DuePolicies =
				CALCULATE(
					COUNTROWS(fact_persistency),
					CROSSFILTER(fact_persistency[issue_date_key], dim_date[date_key], NONE),
					USERELATIONSHIP(fact_persistency[renewal_due_date_key], dim_date[date_key])
				)
			RETURN
				DIVIDE(RenewedPolicies, DuePolicies)
		formatString: 0.0%
		lineageTag: be09ec00-1d67-4ae4-b6e9-74aaa404f321

	measure 'Active Policy Count' =
			VAR ActivePolicySnapshot =
				LASTNONBLANKVALUE(
					dim_date[date],
					VAR SnapshotDateKey = MAX(dim_date[date_key])
					RETURN
						CALCULATE(
							DISTINCTCOUNT(fact_persistency[policy_id]),
							CROSSFILTER(fact_persistency[issue_date_key], dim_date[date_key], NONE),
							FILTER(
								fact_persistency,
								fact_persistency[issue_date_key] <= SnapshotDateKey
									&& fact_persistency[renewal_status] <> "lapsed"
							)
						)
				)
			RETURN
				ActivePolicySnapshot
		formatString: #,##0
		lineageTag: 4d7bfafe-090e-4eb0-a440-7d46a3184c79

	measure 'Renewed Policy Count' =
			VAR RenewedPolicies =
				CALCULATE(
					DISTINCTCOUNT(fact_persistency[policy_id]),
					fact_persistency[renewal_status] = "renewed",
					CROSSFILTER(fact_persistency[issue_date_key], dim_date[date_key], NONE),
					USERELATIONSHIP(fact_persistency[renewal_due_date_key], dim_date[date_key])
				)
			RETURN
				RenewedPolicies
		formatString: #,##0
		lineageTag: 54382046-6bcb-411d-8238-2baa7b415f1d

	measure 'Due Policy Count' =
			VAR DuePolicies =
				CALCULATE(
					DISTINCTCOUNT(fact_persistency[policy_id]),
					fact_persistency[renewal_status] IN {"renewed", "lapsed", "grace"},
					CROSSFILTER(fact_persistency[issue_date_key], dim_date[date_key], NONE),
					USERELATIONSHIP(fact_persistency[renewal_due_date_key], dim_date[date_key])
				)
			RETURN
				DuePolicies
		formatString: #,##0
		lineageTag: 1674d1fe-2ecd-4d1c-89bf-9f12ef6ca517

	measure 'Cohort Renewal Rate' =
			VAR CohortRenewalRate = DIVIDE([Renewed Policy Count], [Due Policy Count])
			RETURN
				CohortRenewalRate
		formatString: 0.0%
		lineageTag: af21ca1c-4486-48ab-aef9-0f3e8c2e06a2

